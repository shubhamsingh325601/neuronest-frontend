# NeuroNest Frontend Environment Configuration

NEXT_PUBLIC_SITE_URL=https://neuronest.co.uk

# Google Sheets Webhook URL
# 1. Follow the instructions in scripts/google-sheets-sync.gs
# 2. Deploy your Google Apps Script as a Web App (Access: Anyone)
# 3. Paste the deployment URL below:
GOOGLE_SHEETS_WEBHOOK_URL=

# Admin app (optional)
# Comma-separated extra hostnames served as the Admin app (ports ignored). Any host starting with
# "admin." is already treated as Admin, e.g. http://admin.localhost:3001 in development.
# Needed only when the Admin host does not start with "admin." (see docs/plans/0001-admin-app.md §3).
ADMIN_HOSTS=

# Admin app: backend (server-side only; read by the BFF, never exposed to the browser)
# The backend ORIGIN, without /v1 (the API paths already include it). Defaults to http://localhost:4000 in
# development; required in production.
API_BASE_URL=

# Admin app: data source (names only; the defaults are what you want). NEXT_PUBLIC_ values are inlined into the
# browser bundle at build time, so never put a secret in them.
#   NEXT_PUBLIC_ADMIN_DATA_SOURCE=live|mock          default live; "mock" serves mock data for every Admin feature
#   NEXT_PUBLIC_ADMIN_MOCK_FEATURES=dashboard,system mock only the listed features
#   ALLOW_ADMIN_MOCKS=1                              a production build refuses mock sources unless this is set
NEXT_PUBLIC_ADMIN_DATA_SOURCE=
NEXT_PUBLIC_ADMIN_MOCK_FEATURES=
ALLOW_ADMIN_MOCKS=
